    "client = OpenAI()\n",
    "\n",
    "response = client.embeddings.create(\n",
    "    input=\"I am a test string.\",\n",
    "    model=\"text-embedding-3-small\"\n",
    ")\n",
    "\n",
    "vector = response.data[0].embedding\n",
    "len(vector)"
   ]
